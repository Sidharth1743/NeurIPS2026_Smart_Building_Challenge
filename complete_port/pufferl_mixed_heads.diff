+    # ride EXTRA_SRC into the nvcc line like impulse_wars_api.c.
+    # Web builds excluded: the x86 archive cannot link under emscripten.
+    if [ -z "${MODE:-}" ] || [ "$MODE" = "native" ] || [ "$MODE" = "profile" ] || [ "$MODE" = "cpu" ]; then
