+// Zone-critic buffers. Called before the first rollout so the captured rollout graphs
+// contain the zone-value writer, and again (a no-op) from train_impl.
+static void sbs_zone_alloc(Hypers* hypers) {
+    if ((g_sbs_zone_critic || g_sbs_room_value) && g_zv_roll == nullptr) {
+        if (g_adv_norm != 2) {
+            fprintf(stderr, "pufferl: per-zone value needs adv_norm=2\n");
+            abort();
+        }
+        if (sb_rz_rows(0, hypers->horizon) == nullptr) {
+            fprintf(stderr, "pufferl: zone critic has no per-zone return (env.zone_critic=1)\n");
+            abort();
+        }
+        if (sb_rz_width() != g_sbs_zw) {
+            fprintf(stderr, "pufferl: env exports %d returns per step, the critic has %d rows (env.ahu_critic and train.ahu_critic must match)\n",
+                sb_rz_width(), g_sbs_zw);
+            abort();
+        }
+        int rows = hypers->minibatch_size / hypers->horizon;
+        int agents = hypers->total_agents;
+        int horizon = hypers->horizon;
+        if (rows < 1 || horizon < 1 || agents < 1 || agents % rows) {
+            fprintf(stderr, "pufferl: zone critic geometry unsupported\n");
+            abort();
+        }
+        g_zv_agents = agents;
+        g_zv_blocks = agents / rows;
+        auto grab = [](float** p, size_t n) {
+            if (cudaMalloc((void**)p, n * sizeof(float)) != cudaSuccess) {
+                fprintf(stderr, "pufferl: zone critic buffer alloc failed\n");
+                abort();
+            }
+        };
+        // One slot per async rollout: the rollout graphs bake this pointer at capture, so the
+        // buffer must exist before the first rollout (sbs_zone_alloc runs before it).
+        int slots = hypers->async ? 2 : 1;
+        if(g_zone_pass_refresh){
+            int total=(int)(hypers->replay_ratio*(double)agents*horizon/hypers->minibatch_size);
+            if(total<g_zv_blocks || total%g_zv_blocks){fprintf(stderr,"zone pass refresh requires whole replay passes\n");abort();}
+            g_zpass_passes=total/g_zv_blocks;
+            grab(&d_zpass_adv,(size_t)slots*agents*horizon*g_sbs_zw);
+            grab(&d_zpass_ret,(size_t)slots*agents*horizon*g_sbs_zw);
+            grab(&g_zpass_stats,(size_t)slots*g_zpass_passes*2);
+            assert(cudaMalloc(&g_zpass_counts,(size_t)slots*g_zpass_passes*sizeof(int))==cudaSuccess);
+            assert(cudaMemset(g_zpass_counts,0,(size_t)slots*g_zpass_passes*sizeof(int))==cudaSuccess);
+            const char* check=getenv("SB_ZPASS_ASSERT");g_zpass_assert=check && strcmp(check,"1")==0;
+        }
+        grab(&g_zv_roll, (size_t)slots * agents * horizon * g_sbs_zw);
+        grab(&d_zold, (size_t)agents * horizon * g_sbs_zw);
+        size_t slice = (size_t)rows * horizon * g_sbs_zw;
+        grab(&d_zpred, slice);
+        grab(&d_zadv, slice);
+        grab(&d_zret, slice);
+        grab(&d_zgrad, slice);
+        grab(&d_zpairs, (size_t)g_zv_blocks * 3);
+        grab(&d_zstats, 2);
+        g_sbs_zgrad = d_zgrad;
+        ppo_bind_zone_adv(d_zadv, d_zstats);
+        if (g_sbs_ahu_critic) {
+            grab(&d_apairs, (size_t)g_zv_blocks * 3);
+            grab(&d_astats, 2);
+            ppo_bind_ahu_adv(g_sbs_zw, CN_AA, CN_K, d_astats);
+        } else {
+            ppo_bind_ahu_adv(CN_ZS, 0, 0, nullptr);
