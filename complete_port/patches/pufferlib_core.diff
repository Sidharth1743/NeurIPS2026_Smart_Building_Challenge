+// SB_CREDIT=<agents per group> (diagnostic, needs train.update_diagnostics=1 and policy.beta=1): per agent and
+// head type, the sums of A (x - m), (x - m)^2, A^2 and the count over every minibatch visit of the epoch, where x
+// is the stored Beta draw, m the current Beta mean and A the advantage that type's loss uses (building advantage
+// whitened by adv_stats; damper and reheat use the configured global, zone, or blended advantage; AHU types use
+// that AHU's whitened advantage when ahu_critic is on). A positive first
+// sum means draws above the mean carried the higher advantage: the update pushes the mean up. Read-only: nothing
+// here feeds the update. Printed once per epoch per group as SB_CREDIT.
+constexpr int SBS_CR_TYPES=8;
+static double* sbs_cr_acc=nullptr;
+// Optional matched global/zone advantage moments and current policy means for valve heads.
+constexpr int SBS_VC_COLS=13;
+static double* sbs_vc_acc=nullptr;
+static int sbs_cr_block=0,sbs_cr_agents=0;
+__global__ void sbs_credit_k(const precision_t* dec,const precision_t* mask,const float* acts,
+        const precision_t* adv,const float* stats,const float* zadv,const float* zstats,double* acc,
+        double* vc, int valve_global, int valve_zone,
+        int rows,int width,int Tmb,int num_atns,int agent0,int zw,const float* astats){
+    __shared__ double sh[256];
+    const int seg=blockIdx.x,tid=threadIdx.x;
+    double s[SBS_CR_TYPES*4], v[2*SBS_VC_COLS];
+    for(int k=0;k<SBS_CR_TYPES*4;++k)s[k]=0.0;
+    for(int k=0;k<2*SBS_VC_COLS;++k)v[k]=0.0;
+    for(int t=tid;t<Tmb;t+=blockDim.x){
+        const int r=seg*Tmb+t;
+        const double A=stats?((double)to_float(adv[r])-stats[0])*stats[1]:(double)to_float(adv[r]);
+        for(int ty=0;ty<SBS_CR_TYPES;++ty){
+            const int n=ty<4?CN_K:(ty<6?1:CN_ZS);
+            for(int i=0;i<n;++i){
+                const int h=ty<4?180+4*i+ty:(ty<6?212+ty:2*i+(ty-6));
+                if(h>=width||to_float(mask[(size_t)r*width+h])==0)continue;
+                double al,be;sbs_beta_params(dec,rows,width,r,h,&al,&be);
+                const double m=binary_run_slot(h)?(double)sbs_binary_p(dec,width,r,h):al/(al+be);
+                const double d=(double)acts[(size_t)r*num_atns+h]-m;
+                double a=A;
+                if(ty>=6&&zadv!=nullptr){
+                    double z=zadv[(size_t)r*zw+i];
+                    if(zstats)z=(z-zstats[0])*zstats[1];
+                    z=isfinite(z)?z:0.0;
+                    a=valve_global?A:(valve_zone?z:0.70*A+0.30*z);
+                    if(vc!=nullptr){
+                        const int b=(ty-6)*SBS_VC_COLS;
+                        const double x=(double)acts[(size_t)r*num_atns+h];
+                        v[b+0]+=1.0; v[b+1]+=A; v[b+2]+=z;
+                        v[b+3]+=A*A; v[b+4]+=z*z; v[b+5]+=A*z;
+                        v[b+6]+=A*d; v[b+7]+=z*d; v[b+8]+=m; v[b+9]+=m*m;
+                        v[b+10]+=x; v[b+11]+=x*x; v[b+12]+=(A*z<0.0)?1.0:0.0;
+                    }
+                }else if(ty<4&&zadv!=nullptr&&astats!=nullptr){
+                    double z=((double)zadv[(size_t)r*zw+CN_ZS+i]-astats[0])*astats[1];
+                    a=isfinite(z)?z:0.0;
+                }
+                s[4*ty]+=a*d;s[4*ty+1]+=d*d;s[4*ty+2]+=a*a;s[4*ty+3]+=1.0;
+            }
+        }
+    }
+    for(int k=0;k<SBS_CR_TYPES*4;++k){
+        sh[tid]=s[k];__syncthreads();
+        for(int w=blockDim.x/2;w;w>>=1){if(tid<w)sh[tid]+=sh[tid+w];__syncthreads();}
+        if(tid==0)acc[(size_t)(agent0+seg)*SBS_CR_TYPES*4+k]+=sh[0];
+        __syncthreads();
+    }
+    if(vc!=nullptr){
+        for(int k=0;k<2*SBS_VC_COLS;++k){
+            sh[tid]=v[k]; __syncthreads();
+            for(int w=blockDim.x/2;w;w>>=1){if(tid<w)sh[tid]+=sh[tid+w];__syncthreads();}
+            if(tid==0)vc[(size_t)(agent0+seg)*2*SBS_VC_COLS+k]+=sh[0];
+            __syncthreads();
+        }
+    }
+}
