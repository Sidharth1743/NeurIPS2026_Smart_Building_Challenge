+// Reductions are per agent and serialized by the training stream, so no atomics
+// or cross-scenario mixing. Values include every active head and replay visit.
+__global__ void head_diag_reduce(const double* rows, double* out, double* first, int N, int T, int agent0) {
+    __shared__ double sh[128];
+    int b=blockIdx.x, tid=threadIdx.x;
+    if (b >= N) return;
+    for (int k=0; k<HEAD_ROLES*HEAD_COLS; ++k) {
+        double s=0.;
+        for (int t=tid; t<T; t+=blockDim.x) s+=rows[((size_t)b*T+t)*HEAD_ROLES*HEAD_COLS+k];
+        sh[tid]=s; __syncthreads();
+        for (int stride=64; stride; stride>>=1) { if (tid<stride) sh[tid]+=sh[tid+stride]; __syncthreads(); }
+        if (!tid) {
+            size_t i=(size_t)(agent0+b)*HEAD_ROLES*HEAD_COLS+k;
+            out[i]+=sh[0];
+            if (first) first[i]+=sh[0];
+        }
+        __syncthreads();
+    }
+}
