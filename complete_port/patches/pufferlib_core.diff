+// Regularised incomplete beta I_x(a, b), continued fraction (modified Lentz), for x < (a + 1) / (a + b + 2).
+static double binary_run_ibeta(double a, double b, double x) {
+    const double front = exp(a * log(x) + b * log1p(-x) - (lgamma(a) + lgamma(b) - lgamma(a + b))) / a;
+    double f = 1.0, c = 1.0, d = 0.0;
+    for (int i = 0; i <= 400; ++i) {
+        const int m = i / 2;
+        double num;
+        if (i == 0) num = 1.0;
+        else if (i % 2 == 0) num = m * (b - m) * x / ((a + 2.0 * m - 1.0) * (a + 2.0 * m));
