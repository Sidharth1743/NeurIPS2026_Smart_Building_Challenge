+__global__ void ars_fill_k(float* d, int n, unsigned long long seed) {
+    int i = blockIdx.x * blockDim.x + threadIdx.x;
+    if (i >= n) return;
+    curandStatePhilox4_32_10_t s;
+    curand_init(seed, (unsigned long long)i, 0, &s);
+    d[i] = curand_normal(&s);
+}
+__global__ void ars_apply_k(float* w, const float* base, const float* delta, float scale, int n) {
+    int i = blockIdx.x * blockDim.x + threadIdx.x;
+    if (i < n) w[i] = base[i] + scale * delta[i];
+}
+__global__ void ars_accum_k(float* base, const float* delta, float coef, int n) {
+    int i = blockIdx.x * blockDim.x + threadIdx.x;
+    if (i < n) base[i] += coef * delta[i];
+}
+__global__ void ars_sum_k(const precision_t* x, int n, float* out) {
+    double s = 0.0;
+    for (int i = threadIdx.x; i < n; i += blockDim.x) s += (double)to_float(x[i]);
+    __shared__ double sh[256];
+    sh[threadIdx.x] = s;
+    __syncthreads();
+    for (int k = 128; k > 0; k >>= 1) {
+        if (threadIdx.x < k) sh[threadIdx.x] += sh[threadIdx.x + k];
+        __syncthreads();
+    }
+    if (threadIdx.x == 0) *out = (float)sh[0];
+}
+
+static void ars_zero_state(PuffeRL* p) {
+    for (int b = 0; b < p->num_policies; b++) {
+        for (int i = 0; i < p->hypers.num_buffers; i++) {
+            Prec* st = &p->policies[b].buffer_states[i];
+            cudaMemset(st->data, 0, (size_t)numel(st->shape) * sizeof(precision_t));
+        }
+    }
+}
+
+// One whole episode. The mean per-step official reward, averaged over the envs.
+static float ars_episode(PuffeRL* p, float* scratch, int ep) {
+    cudaDeviceSynchronize();
+    int H = p->hypers.horizon;
+    int B = p->hypers.total_agents;
+    int windows = ep / H;
+    ars_zero_state(p);
+    double sum = 0.0;
+    for (int w = 0; w < windows; w++) {
+        rollout_start(p, 0);
+        rollout_finish(p, 0);
+        const precision_t* rew = p->rollouts.rewards.data
+            + (long)p->write_slot * H * B;
+        cudaMemset(scratch, 0, sizeof(float));
+        ars_sum_k<<<1, 256>>>(rew, H * B, scratch);
+        float part = 0.0f;
+        cudaMemcpy(&part, scratch, sizeof(float), cudaMemcpyDeviceToHost);
+        sum += (double)part;
+        p->global_step += (long)H * B;
+    }
+    return (float)(sum / ((double)windows * H * B));
+}
+
+static void ars_run(PuffeRL* p, Ini* ini, TrainContext* ctx,
+        const char* checkpoint_dir, char* final_checkpoint) {
+    int n = (int)numel(p->policies[0].master_weights.shape);
+    int ep = p->vec->envs[0].max_steps;
+    int H = p->hypers.horizon;
+    if (ep <= 0 || H <= 0 || ep % H != 0) {
+        fprintf(stderr, "pufferl: ARS episode %d is not a whole number of horizons %d\n", ep, H);
+        abort();
+    }
+    float* base = NULL;
+    float* delta = NULL;
+    float* scratch = NULL;
+    cudaMalloc((void**)&base, (size_t)n * sizeof(float));
+    cudaMalloc((void**)&delta, (size_t)n * sizeof(float));
+    cudaMalloc((void**)&scratch, sizeof(float));
+    float* rp = (float*)malloc(sizeof(float) * (size_t)g_ars_dirs);
+    float* rm = (float*)malloc(sizeof(float) * (size_t)g_ars_dirs);
+    unsigned long long seed0 = (unsigned long long)puf_ini_get(ini, "base", "seed");
+    if (seed0 == 0) seed0 = 1;
+    fprintf(stderr, "pufferl: ARS %d params, episode %d steps, %d envs, horizon %d\n",
+        n, ep, p->hypers.total_agents, H);
+    fflush(stderr);
+    int grid = (n + 255) / 256;
+    for (int g = 0; g <= g_ars_gens; g++) {
+        if (g > 0) {
+            cudaMemcpy(base, p->policies[0].master_weights.data,
+                (size_t)n * sizeof(float), cudaMemcpyDeviceToDevice);
+            for (int d = 0; d < g_ars_dirs; d++) {
+                unsigned long long seed = seed0 * 1000003ull
+                    + (unsigned long long)g * 10007ull + (unsigned long long)d + 1ull;
+                ars_fill_k<<<grid, 256>>>(delta, n, seed);
+                ars_apply_k<<<grid, 256>>>(p->policies[0].master_weights.data, base, delta, g_ars_nu, n);
+                rp[d] = ars_episode(p, scratch, ep);
+                ars_apply_k<<<grid, 256>>>(p->policies[0].master_weights.data, base, delta, -g_ars_nu, n);
+                rm[d] = ars_episode(p, scratch, ep);
+                fprintf(stderr, "pufferl: ARS gen %d dir %d plus %.4f minus %.4f\n", g, d, rp[d], rm[d]);
+                fflush(stderr);
+            }
+            double mean = 0.0;
+            int m = 2 * g_ars_dirs;
+            for (int d = 0; d < g_ars_dirs; d++) mean += (double)rp[d] + (double)rm[d];
+            mean /= (double)m;
+            double var = 0.0;
+            for (int d = 0; d < g_ars_dirs; d++) {
+                double a = (double)rp[d] - mean, b = (double)rm[d] - mean;
+                var += a * a + b * b;
+            }
+            float stdv = (float)sqrt(var / (double)m);
+            if (!(stdv > 1e-8f)) stdv = 1.0f;
+            for (int d = 0; d < g_ars_dirs; d++) {
+                unsigned long long seed = seed0 * 1000003ull
+                    + (unsigned long long)g * 10007ull + (unsigned long long)d + 1ull;
+                float coef = (g_ars_lr / ((float)g_ars_dirs * stdv)) * (rp[d] - rm[d]);
+                if (!isfinite(coef)) coef = 0.0f;
+                ars_fill_k<<<grid, 256>>>(delta, n, seed);
+                ars_accum_k<<<grid, 256>>>(base, delta, coef, n);
+            }
+            cudaMemcpy(p->policies[0].master_weights.data, base,
+                (size_t)n * sizeof(float), cudaMemcpyDeviceToDevice);
+            fprintf(stderr, "pufferl: ARS gen %d updated, return std %.4f\n", g, stdv);
+            fflush(stderr);
+        }
+        float center = ars_episode(p, scratch, ep);
+        char path[4096];
+        snprintf(path, sizeof(path), "%s/%016ld.bin", checkpoint_dir, p->global_step);
+        if (ctx->artifact_owner) {
+            puf_save_weights(p, path);
+            snprintf(final_checkpoint, 4096, "%s", path);
+        }
+        fprintf(stderr, "pufferl: ARS gen %d step %ld center %.4f saved %s\n",
+            g, p->global_step, center, path);
+        fflush(stderr);
+    }
+    cudaFree(base);
+    cudaFree(delta);
+    cudaFree(scratch);
+    free(rp);
+    free(rm);
+}
