+#ifdef SB_SHARED_POLICY
+__global__ void sbs_norm_k(float* parts, float* stats, int n) {
+    if (threadIdx.x != 0 || blockIdx.x != 0 || parts == nullptr || n <= 0) return;
+    const float beta = 0.01f;
+    for (int c = 0; c < 3; c++) {
+        double sum = 0.0, var = 0.0;
+        for (int i = 0; i < n; i++) sum += parts[(size_t)i * 5 + c];
+        float mean_b = (float)(sum / n);
+        for (int i = 0; i < n; i++) {
+            float d = parts[(size_t)i * 5 + c] - mean_b;
+            var += (double)d * d;
+        }
+        float mean = (1.0f - beta) * stats[c] + beta * mean_b;
+        float variance = (1.0f - beta) * stats[3 + c] + beta * (float)(var / n);
+        if (variance < 1.0e-6f) variance = 1.0e-6f;
+        stats[c] = mean; stats[3 + c] = variance;
+        float inv = rsqrtf(variance);
+        for (int i = 0; i < n; i++) {
+            float z = (parts[(size_t)i * 5 + c] - mean) * inv;
+            parts[(size_t)i * 5 + c] = fminf(20.0f, fmaxf(-20.0f, z));
+        }
+    }
+}
+__global__ void sbs_pack_comp_k(const float* parts, const precision_t* heads, precision_t* rew,
+        precision_t* val, int n, int comp) {
+    int i = blockIdx.x * blockDim.x + threadIdx.x;
+    if (i >= n) return;
+    rew[i] = from_float(parts[(size_t)i * 5 + comp]);
+    val[i] = heads[(size_t)i * 4 + comp];
+}
+__global__ void sbs_shape_k(precision_t* rew, const float* aux, const precision_t* dones,
+        int rows, int H, float gamma) {
+    int i = blockIdx.x * blockDim.x + threadIdx.x;
+    if (i >= rows * H || aux == nullptr || (i % H) == 0) return;
+    float phi = aux[(size_t)i * 4 + 3];
+    float prev = aux[(size_t)(i - 1) * 4 + 3];
+    float cont = to_float(dones[i]) > 0.5f ? 0.0f : 1.0f;
+    rew[i] = from_float(to_float(rew[i]) + gamma * phi * cont - prev);
+}
+__global__ void sbs_timeout_k(precision_t* rew, const precision_t* val, const precision_t* dones,
+        int rows, int H, float gamma) {
+    int i = blockIdx.x * blockDim.x + threadIdx.x;
+    if (i >= rows * H || (i % H) == 0) return;
+    if (to_float(dones[i]) > 0.5f)
+        rew[i] = from_float(to_float(rew[i]) + gamma * to_float(val[i - 1]));
+}
+__global__ void sbs_mix_adv_k(const precision_t* a0, const precision_t* a1, const precision_t* a2,
+        precision_t* adv, int n) {
+    int i = blockIdx.x * blockDim.x + threadIdx.x;
+    if (i >= n) return;
+    float a = 0.6f * to_float(a0[i]) - 0.2f * to_float(a1[i]) - 0.2f * to_float(a2[i]);
+    adv[i] = from_float(a);
+}
+__global__ void sbs_gvf_k(const precision_t* heads, const float* aux, const precision_t* dones,
+        float* extra, int rows, int H) {
+    int row = blockIdx.x * blockDim.x + threadIdx.x;
+    if (row >= rows || aux == nullptr) return;
+    for (int t = 0; t < H; t++) {
+        int i = row * H + t;
+        float vg = to_float(heads[(size_t)i * 4 + 3]);
+        float target = vg;
+        int live = t + 1 < H;
+        if (live) {
+            float c0 = aux[(size_t)i * 4 + 2], c1 = aux[(size_t)(i + 1) * 4 + 2];
+            if (c1 > 0.5f && c0 <= 0.5f) target = aux[(size_t)(i + 1) * 4];
+            else if (to_float(dones[i + 1]) > 0.5f) target = aux[(size_t)i * 4];
+            else target = to_float(heads[(size_t)(i + 1) * 4 + 3]);
+        }
+        extra[(size_t)i * 4] = 0.0f; extra[(size_t)i * 4 + 1] = 0.0f; extra[(size_t)i * 4 + 2] = 0.0f;
+        extra[(size_t)i * 4 + 3] = live ? 0.5f * (vg - target) : 0.0f;
+    }
+}
