+    if(g_rec_shapes_f)
+        assert(fwrite(g_rec_h_shapes,sizeof(double),(size_t)B*A*2,g_rec_shapes_f)==(size_t)B*A*2);
+    assert(fwrite(g_rec_h_obs, sizeof(float), (size_t)B * F, g_rec_obs_f) == (size_t)B * F);
+    assert(fwrite(g_rec_h_loc, sizeof(float), (size_t)B * A, g_rec_loc_f) == (size_t)B * A);
+    assert(fwrite(g_rec_h_rew, sizeof(float), (size_t)B, g_rec_rew_f) == (size_t)B);
+    assert(fwrite(g_rec_h_done, sizeof(float), (size_t)B, g_rec_done_f) == (size_t)B);
+    g_rec_written++;
+    if (g_rec_written % 256 == 0) {
+        fflush(g_rec_obs_f); fflush(g_rec_loc_f); fflush(g_rec_rew_f); fflush(g_rec_done_f);
+        if (g_rec_conc_f) fflush(g_rec_conc_f);
+        if (g_rec_shapes_f) fflush(g_rec_shapes_f);
+        if (g_rec_parts_f) fflush(g_rec_parts_f);
+        if (g_rec_feat_f) fflush(g_rec_feat_f);
+        fprintf(stderr, "SB_RECORD steps %ld\n", g_rec_written);
+        fflush(stderr);
+    }
