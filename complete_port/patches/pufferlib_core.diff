+// SB_PPD=<weights file> (diagnostic, needs SB_CREDIT): which part of the update moves the AHU and plant Beta means.
+// Types sat sp recirc run (role 1, one per AHU node) and water pump (role 2). Per minibatch visit, J_u and J_v are
+// the sums over the visit's live nodes of dm/du * input and dm/dv * input, m = alpha/(alpha+beta), input the
+// readout's input row; J . dW / n is the first-order change of the visit's mean m for a readout change dW. Recorded
+// per visit: the applied step (master weights after the optimizer minus before) and the descent direction -G of
+// three loss gradients (as trained; entropy off; entropy and ratio clip off). Also the clip on the joint ratio,
+// split by the sign of the whitened advantage. Read-only. Per epoch: SB_PPD rows per group and the two readout
+// matrices appended to the weights file.
+constexpr int PPD_T=6, PPD_TC=10, PPD_CL=8, PPD_W=PPD_T*PPD_TC+PPD_CL, PPD_FMAX=320, PPD_V=8;
+// per type: step, d_tot, d_pol, d_noclip, flip(step vs d_tot), flip(d_pol vs d_noclip), visits, sum_m, sum_conc, n
+// clip: n, n_posA, bind_posA, bind_negA, sum_logratio, sum_abs_logratio, n_outside, sum_A
+static double* ppd_acc=nullptr;   // [groups][PPD_W]
+static double* ppd_v=nullptr;     // per visit [PPD_T][PPD_V]: P_tot, P_pol, P_noclip, n
+static float* ppd_J=nullptr;      // [PPD_T][2][PPD_FMAX]
+static float* ppd_wb=nullptr;     // role 1 then role 2 master weights before the step
+static long ppd_off[3]={0,0,0};
+static int ppd_len[3]={0,0,0};
+static FILE* ppd_wf=nullptr;
+__device__ __forceinline__ void ppd_type(int t,int H,int* role,int* nodes,int* c,int* F,int* base){
+    *role=t<4?1:2;*nodes=t<4?CN_K:1;*c=t<4?t:t-4;*F=H+(t<4?SBS_LA:SBS_LH);*base=t<4?4:3;
+}
+__device__ __forceinline__ bool ppd_live(const precision_t* raw,const precision_t* mask,int b,int width,int role,int k,int h){
+    const precision_t* o=raw+(size_t)b*OBS_SIZE;
+    bool ex=role==1?to_float(o[CN_OA+CN_FA*k])!=0:to_float(o[CN_OH])!=0;
+    return ex&&to_float(mask[(size_t)b*width+h])!=0;
+}
+__device__ __forceinline__ int ppd_col(int role,int k,int c){return role==1?CN_AA+4*k+c:CN_AH+c;}
+__global__ void ppd_clip_k(const float* newlp,const precision_t* oldlp,const precision_t* adv,const float* stats,
+        const precision_t* mask,const int* act_sizes,int num_atns,int width,int n,float clip,double* out){
+    __shared__ double sh[256];
+    double s[PPD_CL];for(int k=0;k<PPD_CL;++k)s[k]=0.0;
+    for(int r=threadIdx.x;r<n;r+=blockDim.x){
+        int d_act=0,off=0;
+        for(int h=0;h<num_atns;++h){if(ppo_head_active(mask,r*width,off,act_sizes[h]))d_act++;off+=act_sizes[h];}
+        float lr=(newlp[r]-to_float(oldlp[r]))/(float)(d_act>0?d_act:1);
+        if(!isfinite(lr))lr=0.0f;lr=fminf(20.0f,fmaxf(-20.0f,lr));
+        float ratio=__expf(lr);
+        double A=stats?((double)to_float(adv[r])-stats[0])*stats[1]:(double)to_float(adv[r]);
+        bool out_=ratio<=1.0f-clip||ratio>=1.0f+clip;
+        s[0]+=1;s[1]+=A>0;s[2]+=(A>0&&ratio>=1.0f+clip);s[3]+=(A<0&&ratio<=1.0f-clip);
+        s[4]+=lr;s[5]+=fabsf(lr);s[6]+=out_;s[7]+=A;
+    }
+    for(int k=0;k<PPD_CL;++k){
+        sh[threadIdx.x]=s[k];__syncthreads();
+        for(int w=blockDim.x/2;w;w>>=1){if(threadIdx.x<w)sh[threadIdx.x]+=sh[threadIdx.x+w];__syncthreads();}
+        if(threadIdx.x==0)out[k]+=sh[0];
+        __syncthreads();
+    }
+}
+// grid (PPD_T*2, chunks), block PPD_FMAX: J[t][uv][f] += sum over this chunk's rows of dm * input[f].
+__global__ void ppd_J_k(const precision_t* dec,const precision_t* raw,const precision_t* mask,
+        const precision_t* in1,const precision_t* in2,float* J,int rows,int width,int H){
+    const int t=blockIdx.x>>1,uv=blockIdx.x&1,f=threadIdx.x;
+    int role,nodes,c,F,base;ppd_type(t,H,&role,&nodes,&c,&F,&base);
+    const precision_t* in=role==1?in1:in2;
+    const int per=(rows+gridDim.y-1)/gridDim.y,b0=blockIdx.y*per,b1=min(rows,b0+per);
+    float acc=0.0f;
+    for(int b=b0;b<b1;++b)for(int k=0;k<nodes;++k){
+        const int h=ppd_col(role,k,c);
+        if(!ppd_live(raw,mask,b,width,role,k,h))continue;
+        const float u=finite_or_clamp(to_float(dec[(size_t)b*(width+1)+h]),-1.0e6f,1.0e6f);
+        const float v=finite_or_clamp(to_float(dec[(size_t)rows*(width+1)+(size_t)b*(width+1)+h]),-1.0e6f,1.0e6f);
+        const float al=beta_concentration_f(u),be=beta_concentration_f(v),s=al+be;
+        float dm=d_beta_mean_precision ? (uv==0?beta_sigmoid_f(u)*beta_sigmoid_f(-u):0.0f)
+                 : (uv==0?beta_sigmoid_f(u)*be/(s*s):-beta_sigmoid_f(v)*al/(s*s));
+        if(binary_run_slot(h)){const float p=binary_run_prob_f(u);dm=uv==0?p*(1.0f-p):0.0f;}
+        if(f<F)acc+=dm*to_float(in[((size_t)b*nodes+k)*F+f]);
+    }
+    if(f<F)atomicAdd(&J[((size_t)t*2+uv)*PPD_FMAX+f],acc);
+}
+// one block per type: live count, sum of m and of alpha+beta into the group row; n into the visit row.
+__global__ void ppd_stat_k(const precision_t* dec,const precision_t* raw,const precision_t* mask,
+        double* acc,double* v,int rows,int width,int H){
+    __shared__ double sh[3][256];
+    const int t=blockIdx.x;int role,nodes,c,F,base;ppd_type(t,H,&role,&nodes,&c,&F,&base);
+    double n=0,sm=0,sc=0;
+    for(int b=threadIdx.x;b<rows;b+=blockDim.x)for(int k=0;k<nodes;++k){
+        const int h=ppd_col(role,k,c);
+        if(!ppd_live(raw,mask,b,width,role,k,h))continue;
+        double al,be;sbs_beta_params(dec,rows,width,b,h,&al,&be);
+        if(binary_run_slot(h)){n+=1;sm+=sbs_binary_p(dec,width,b,h);continue;}   // no concentration: adds 0
+        n+=1;sm+=al/(al+be);sc+=al+be;
+    }
+    sh[0][threadIdx.x]=n;sh[1][threadIdx.x]=sm;sh[2][threadIdx.x]=sc;__syncthreads();
+    for(int w=blockDim.x/2;w;w>>=1){if(threadIdx.x<w)for(int q=0;q<3;++q)sh[q][threadIdx.x]+=sh[q][threadIdx.x+w];__syncthreads();}
+    if(threadIdx.x==0){acc[t*PPD_TC+7]+=sh[1][0];acc[t*PPD_TC+8]+=sh[2][0];acc[t*PPD_TC+9]+=sh[0][0];v[t*PPD_V+3]=sh[0][0];}
+}
+// one thread per (row, node): P_s[t] += gu_s * (input . J_u) + gv_s * (input . J_v) for the three gradients.
+__global__ void ppd_proj_k(const precision_t* raw,const precision_t* mask,const precision_t* in1,const precision_t* in2,
+        const float* J,const float* gl0,const float* gs0,const float* gl1,const float* gs1,const float* gl2,const float* gs2,
+        double* v,int rows,int width,int H){
+    __shared__ double sh[PPD_T*3][128];
+    const int i=blockIdx.x*blockDim.x+threadIdx.x,n1=rows*CN_K;
+    double p[PPD_T*3];for(int q=0;q<PPD_T*3;++q)p[q]=0.0;
+    if(i<n1+rows){
+        const bool r1=i<n1;const int b=r1?i/CN_K:i-n1,k=r1?i%CN_K:0;
+        for(int t=r1?0:4;t<(r1?4:PPD_T);++t){
+            int role,nodes,c,F,base;ppd_type(t,H,&role,&nodes,&c,&F,&base);
+            const int h=ppd_col(role,k,c);
+            if(!ppd_live(raw,mask,b,width,role,k,h))continue;
+            const precision_t* x=(r1?in1:in2)+((size_t)b*nodes+k)*F;
+            const float* Ju=J+(size_t)t*2*PPD_FMAX;const float* Jv=Ju+PPD_FMAX;
+            float du=0.0f,dv=0.0f;
+            for(int f=0;f<F;++f){float xf=to_float(x[f]);du+=xf*Ju[f];dv+=xf*Jv[f];}
+            const size_t g=(size_t)b*width+h;
+            p[t*3+0]+=(double)gl0[g]*du+(double)gs0[g]*dv;
+            p[t*3+1]+=(double)gl1[g]*du+(double)gs1[g]*dv;
+            p[t*3+2]+=(double)gl2[g]*du+(double)gs2[g]*dv;
+        }
+    }
+    for(int q=0;q<PPD_T*3;++q)sh[q][threadIdx.x]=p[q];
+    __syncthreads();
+    for(int w=blockDim.x/2;w;w>>=1){if(threadIdx.x<w)for(int q=0;q<PPD_T*3;++q)sh[q][threadIdx.x]+=sh[q][threadIdx.x+w];__syncthreads();}
+    if(threadIdx.x==0)for(int t=0;t<PPD_T;++t)for(int s=0;s<3;++s)atomicAdd(&v[t*PPD_V+s],sh[t*3+s][0]);
+}
+// one block per type, after the optimizer: J . (W_after - W_before) for the u and v rows, then the visit row
+// goes into the group row (all divided by n) and is cleared.
+__global__ void ppd_step_k(const float* master,const float* wb,long off1,long off2,int len1,const float* J,
+        double* v,double* acc,int H){
+    __shared__ double sh[256];
+    const int t=blockIdx.x;int role,nodes,c,F,base;ppd_type(t,H,&role,&nodes,&c,&F,&base);
+    const float* wa=master+(role==1?off1:off2);const float* w0=wb+(role==1?0:len1);
+    const float* Ju=J+(size_t)t*2*PPD_FMAX;const float* Jv=Ju+PPD_FMAX;
+    double s=0.0;
+    for(int f=threadIdx.x;f<F;f+=blockDim.x){
+        const int ru=c*F+f,rv=(base+c)*F+f;
+        s+=(double)Ju[f]*((double)wa[ru]-(double)w0[ru])+(double)Jv[f]*((double)wa[rv]-(double)w0[rv]);
+    }
+    sh[threadIdx.x]=s;__syncthreads();
+    for(int w=blockDim.x/2;w;w>>=1){if(threadIdx.x<w)sh[threadIdx.x]+=sh[threadIdx.x+w];__syncthreads();}
+    if(threadIdx.x==0){
+        double* x=v+t*PPD_V;const double n=x[3];
+        if(n>0){
+            const double st=sh[0]/n,dt=-x[0]/n,dp=-x[1]/n,dn=-x[2]/n;
+            double* a=acc+t*PPD_TC;
+            a[0]+=st;a[1]+=dt;a[2]+=dp;a[3]+=dn;a[4]+=(st>0)!=(dt>0);a[5]+=(dp>0)!=(dn>0);a[6]+=1;
+        }
+        for(int q=0;q<PPD_V;++q)x[q]=0.0;
+    }
+}
