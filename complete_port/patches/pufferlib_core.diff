+static void rec_write_step(PuffeRL* p, int t, cudaStream_t stream) {
+    int B = g_rec_B, F = g_rec_F, A = g_rec_A;
+    const precision_t* obs = p->rollouts.observations.data + (long)t * B * F;
+    rec_to_float<<<grid_size(B * F), BLOCK_SIZE, 0, stream>>>(g_rec_stage, obs, B * F);
+    cudaMemcpyAsync(g_rec_h_obs, g_rec_stage, (size_t)B * F * sizeof(float),
+        cudaMemcpyDeviceToHost, stream);
+    cudaMemcpyAsync(g_rec_h_loc, g_rec_rows[t], (size_t)B * A * sizeof(float),
+        cudaMemcpyDeviceToHost, stream);
+    cudaMemcpyAsync(g_rec_h_rew, p->env.rewards.data, (size_t)B * sizeof(float),
+        cudaMemcpyDeviceToHost, stream);
+    cudaMemcpyAsync(g_rec_h_done, p->env.terminals.data, (size_t)B * sizeof(float),
+        cudaMemcpyDeviceToHost, stream);
+    if (g_rec_conc != NULL)
+        cudaMemcpyAsync(g_rec_h_conc, g_rec_conc_rows[t], (size_t)B * A * sizeof(float),
+            cudaMemcpyDeviceToHost, stream);
+    if(g_rec_shapes != NULL)
+        cudaMemcpyAsync(g_rec_h_shapes,g_rec_shape_rows[t],(size_t)B*A*2*sizeof(double),
+            cudaMemcpyDeviceToHost,stream);
+#ifdef SB_SHARED_POLICY
+    if (g_rec_feat != nullptr) {
+        size_t nf=(size_t)B*CN_ZS*SBS_FEAT;
+        cudaMemcpyAsync(g_rec_h_feat,g_rec_feat+(size_t)t*nf,nf*sizeof(float),cudaMemcpyDeviceToHost,stream);
+    }
+#endif
+    cudaStreamSynchronize(stream);
+#ifdef SB_SHARED_POLICY
+    assert(sb_rec_parts(g_rec_h_parts, B * 8) == B * 8);
+    assert(fwrite(g_rec_h_parts, sizeof(double), (size_t)B * 8, g_rec_parts_f) == (size_t)B * 8);
+#endif
