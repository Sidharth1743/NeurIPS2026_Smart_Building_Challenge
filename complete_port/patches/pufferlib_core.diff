+
+// [base] checkpoint_optim = 1: carry the optimizer momentum across segments in a sidecar file
+// (<checkpoint>.mb).  Weights-only checkpoints restart Muon/Adam state cold at every rotation
+// segment; the measured effect (r4) was that each segment partially unlearns the previous one.
+// Muon writes the first-moment buffer. Adam appends the second moment and the
+// int32 bias-correction step. A missing or wrong-sized sidecar aborts: a resume
+// that asked for momentum must not continue with a cold buffer.
+static void puf_save_momentum(PuffeRL* p, const char* path) {
+    Float mb = p->muon.mb;
+    int64_t nparam = numel(mb.shape) * (int64_t)sizeof(float);
+    int64_t nbytes = p->muon.adam ? 2 * nparam + (int64_t)sizeof(int) : nparam;
+    char* buf = (char*)malloc(nbytes);
+    cudaMemcpy(buf, mb.data, nparam, cudaMemcpyDeviceToHost);
+    if (p->muon.adam) {
+        int step = 0;
+        cudaMemcpy(buf + nparam, p->muon.adam_v, nparam, cudaMemcpyDeviceToHost);
+        cudaMemcpy(&step, p->muon.adam_step, sizeof(int), cudaMemcpyDeviceToHost);
+        memcpy(buf + 2 * nparam, &step, sizeof(int));
+    }
+    char tmp[4200], side[4200];
+    snprintf(side, sizeof(side), "%s.mb", path);
+    snprintf(tmp, sizeof(tmp), "%s.tmp.%d", side, getpid());
+    FILE* fp = fopen(tmp, "wb");
+    assert(fp && "failed to open momentum sidecar for writing");
+    assert(fwrite(buf, 1, nbytes, fp) == (size_t)nbytes
+        && "failed to write momentum sidecar");
+    fclose(fp);
+    free(buf);
+    assert(rename(tmp, side) == 0 && "failed to publish momentum sidecar");
+}
+
+static void puf_load_momentum(PuffeRL* p, const char* path) {
+    Float mb = p->muon.mb;
+    int64_t nparam = numel(mb.shape) * (int64_t)sizeof(float);
+    int64_t want = p->muon.adam ? 2 * nparam + (int64_t)sizeof(int) : nparam;
+    FILE* fp = fopen(path, "rb");
+    if (!fp) {
+        fprintf(stderr, "pufferl: no momentum sidecar at %s\n", path);
+        abort();
+    }
+    fseek(fp, 0, SEEK_END);
+    int64_t nbytes = ftell(fp);
+    fseek(fp, 0, SEEK_SET);
+    if (nbytes != want) {
+        fprintf(stderr, "pufferl: momentum sidecar %s is %lld bytes, this optimizer wants %lld\n",
+            path, (long long)nbytes, (long long)want);
+        fclose(fp);
+        abort();
+    }
+    char* buf = (char*)malloc(nbytes);
+    size_t nread = fread(buf, 1, nbytes, fp);
+    fclose(fp);
+    if ((int64_t)nread != nbytes) {
+        fprintf(stderr, "pufferl: momentum sidecar %s truncated (%zu/%lld bytes)\n",
+            path, nread, (long long)nbytes);
+        free(buf);
+        abort();
+    }
+    assert(cudaMemcpy(mb.data, buf, nparam, cudaMemcpyHostToDevice) == cudaSuccess);
+    if (p->muon.adam) {
+        int step = 0;
+        assert(cudaMemcpy(p->muon.adam_v, buf + nparam, nparam, cudaMemcpyHostToDevice) == cudaSuccess);
+        memcpy(&step, buf + 2 * nparam, sizeof(int));
+        assert(cudaMemcpy(p->muon.adam_step, &step, sizeof(int), cudaMemcpyHostToDevice) == cudaSuccess);
+    }
+    free(buf);
+    printf("loaded optimizer momentum from %s\n", path);
+    fflush(stdout);
 }
 
