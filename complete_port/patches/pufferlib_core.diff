+// Sample one row every two hours per agent. The same ordered sum is recorded
+// by the rollout sampler, so this catches slot/transpose/indexing corruption.
+__global__ void head_old_audit(const float* head, const precision_t* joint, int B, int T) {
+    int i=blockIdx.x*blockDim.x+threadIdx.x, samples=(T+23)/24;
+    if (i >= B*samples) return;
+    int b=i/samples, t=(i%samples)*24;
+    size_t row=(size_t)b*T+t;
+    float sum=0.f;
+    for (int h=0;h<NUM_ATNS;++h) {
+        float v=head[row*NUM_ATNS+h];
+        if (!isfinite(v)) { asm("trap;"); return; }
+        sum+=v;
+    }
+    float j=to_float(joint[row]);
+    if (!isfinite(j) || fabsf(sum-j)>1e-4f*fmaxf(1.f,fabsf(j))) { asm("trap;"); }
 }
 
